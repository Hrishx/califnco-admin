# --- Admin sign-in (server-only). Both required; the dashboard's Instagram API fails closed without them. ---
# ADMIN_PASSWORD must be 12+ chars. ADMIN_SESSION_SECRET must be 16+ random chars (e.g. `openssl rand -base64 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Google Sheets (server-only). Share the sheet with the service account email as Editor. ---
SHEETS_SPREADSHEET_ID=
SHEETS_TAB_NAME=Products
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n sequences, in quotes.
GOOGLE_PRIVATE_KEY=

# --- Manual Instagram publish (a SEPARATE Activepieces flow, never the scheduled caption flow) ---
# Flow receives POST JSON {rowNumber, productName, caption, imageUrl} with header x-webhook-secret,
# and must reply {"success":true,"postId":"..."} or {"success":false,"error":"..."}.
INSTAGRAM_PUBLISH_WEBHOOK_URL=
INSTAGRAM_PUBLISH_WEBHOOK_SECRET=

# Sheet columns (header row, case-insensitive): Product Name, Description, Image URL, Caption, Caption Date,
# and for publishing: Publish Status, Published At, Publish Error (optional: Post ID).
# Do NOT prefix any of these with NEXT_PUBLIC_.
